 "deterministic": {
  "lines": [
   {
    "i": 3,
    "t0": 0.5,
    "t1": 10.54,
    "path": "out/narration/line_03.wav",
    "text": "Here's the strange part. There are no dice inside this board. Every bounce follows Newton's laws of motion, so the same start should always give the same finish.",
    "phrases": [
     [
      0.5,
      1.73
     ],
