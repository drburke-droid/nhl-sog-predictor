 "deterministic": {
  "lines": [
   {
    "i": 3,
    "t0": 0.5,
    "t1": 10.596,
    "path": "out/narration/line_03.wav",
    "text": "Here's the strange part. Nothing on this board is random. Every bounce follows Newton's laws of motion, so the same release point should always lead to the same slot.",
    "phrases": [
     [
      0.5,
      1.936
     ],
     [
