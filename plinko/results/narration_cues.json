     ],
     [
      8.576,
      9.696
     ]
    ]
   },
   {
    "i": 25,
    "t0": 10.4,
    "t1": 17.34,
    "path": "out/narration/line_25.wav",
    "text": "Take one line through the middle, and two winning spots on it. Now zoom in, a hundred times closer with each row.",
    "phrases": [
     [
      10.4,
      11.98
     ],
     [
      12.18,
      13.87
     ],
     [
      14.17,
