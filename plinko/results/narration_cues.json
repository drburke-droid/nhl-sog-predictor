    "i": 26,
    "t0": 18.761,
    "t1": 27.323,
    "path": "out/narration/line_26.wav",
    "text": "Take its bottom edge, right at the pins, and pick one release point that wins. Now zoom in on it, a hundred times closer with each row.",
    "phrases": [
