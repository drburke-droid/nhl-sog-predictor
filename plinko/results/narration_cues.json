   },
   {
    "i": 25,
    "t0": 10.106,
    "t1": 17.961,
    "path": "out/narration/line_25.wav",
    "text": "Now zoom into one small square, just above the middle of the top row. Even this close, gold and grey are mixed like static.",
    "phrases": [
     [
      10.106,
      11.871
     ],
     [
      12.071,
