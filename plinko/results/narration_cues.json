   },
   {
    "i": 26,
    "t0": 20.6,
    "t1": 23.349,
    "path": "out/narration/line_26.wav",
    "text": "Down to the size of a virus, both look random.",
    "phrases": [
     [
      20.6,
      22.139
     ],
     [
      22.339,
      23.349
     ]
    ]
   },
   {
    "i": 27,
    "t0": 24.6,
    "t1": 32.287,
    "path": "out/narration/line_27.wav",
    "text": "Only within a few atoms does spot two turn solid gold: an island. Spot one never settles: a knife edge.",
